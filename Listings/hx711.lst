   1          #include "HX711.h"
   2          /*****************称重模块引脚定义*******************/
   3          sbit ADDO = P3^2;
   4          sbit ADSK = P3^4;
   5          unsigned long ReadWeight(void)//读取称重传感器函数
   6          {
   7   1        unsigned long Count=0;
   8   1        unsigned char i=0;
   9   1        ADSK=0; //使能AD（PD_SCK 置低）
  10   1        Count=0;
  11   1        while(ADDO); //AD转换未结束则等待，否则开始读取
  12   1        for (i=0;i<24;i++)
  13   1        {
  14   2          ADSK=1; //PD_SCK 置高（发送脉冲）
