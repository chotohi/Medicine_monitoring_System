  16   2          ADSK=0; //PD_SCK 置低
  17   2          if(ADDO) Count++;
  18   2        }
  19   1        ADSK=1;
  20   1        Count=Count^0x800000;//第25个脉冲下降沿来时，转换数据
  21   1        ADSK=0;
  22   1        return(Count);
  23   1      }


