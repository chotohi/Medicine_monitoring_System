 151          static char *AppendUnsignedLong(char *buf, unsigned long value)
 152          {
 153   1          char digits[10];
 154   1          unsigned char count = 0;
 155   1      
 156   1          do
 157   1          {
 158   2              digits[count++] = (char)(value % 10UL) + '0';
 159   2              value /= 10UL;
 160   2          }
 161   1          while(value != 0UL);
 162   1      
 163   1          while(count > 0)
 164   1              *buf++ = digits[--count];
 165   1      
 166   1          return buf;
 167   1      }
