 127          void gpio_write(unsigned char line,
 128                          unsigned char column,
 129                          bit value)
 130          {
 131   1          unsigned char mask = 1 << column;
 132   1      
 133   1          switch(line)
 134   1          {
 135   2              case 0:
 136   2                  if(value) P0 |= mask;
 137   2                  else      P0 &= ~mask;
 138   2                  break;
 139   2              case 1:
 140   2                  if(value) P1 |= mask;
 141   2                  else      P1 &= ~mask;
 142   2                  break;
 143   2              case 2:
 144   2                  if(value) P2 |= mask;
 145   2                  else      P2 &= ~mask;
 146   2                  break;
 147   2          }
 148   1      }
